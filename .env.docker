# Environment configuration for developers using Docker
# Copy this to .env if you're using Docker for local development

# Docker PostgreSQL connection (note port 5433, not 5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/bizops_dev

# Environment mode
NODE_ENV=development

# Use local PostgreSQL driver (not Neon HTTP)
USE_LOCAL_DB=true

# Better Auth configuration
BETTER_AUTH_SECRET=BhiJceS0bjT1xQoduz2krYRzx4av5go4
BETTER_AUTH_URL=http://localhost:5173
