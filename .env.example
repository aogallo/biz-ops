# Local PostgreSQL for Node.js scripts (migrations, seeds, Drizzle Studio)
# This is used by drizzle-kit and tsx commands
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/bizops_dev

# Environment mode
NODE_ENV=development

# Database driver selection
# true = Use local PostgreSQL with node-postgres driver
# false = Use Neon HTTP connection
USE_LOCAL_DB=true

# Better Auth configuration
BETTER_AUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:5173

# Super Admin Seed (for scripts/seed-super-admin.ts)
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=your-secure-password-here
SUPER_ADMIN_NAME=Super Administrator

# Email Service (Resend API for production)
RESEND_API_KEY=re_your_api_key_here
