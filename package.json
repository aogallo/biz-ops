{
  "name": "erp",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf node_modules/.vite node_modules/.cache build ./react-router",
    "build": "react-router build",
    "cf-typegen": "wrangler types",
    "deploy": "npm run build && wrangler deploy",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "preview": "npm run build && vite preview",
    "typecheck": "react-router typegen && tsc -b",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "USE_LOCAL_DB=true drizzle-kit migrate",
    "db:push": "USE_LOCAL_DB=true drizzle-kit push",
    "db:studio": "USE_LOCAL_DB=true drizzle-kit studio",
    "db:seed": "USE_LOCAL_DB=true tsx scripts/seed-local.ts",
    "db:seed:accounts": "tsx scripts/seed-accounts.ts",
    "db:seed:org:permissions": "tsx scripts/seed-organization-permission.ts",
    "db:seed:super-admin": "tsx scripts/seed-super-admin.ts",
    "db:migrate:rbac": "USE_LOCAL_DB=true tsx scripts/migrate-members-to-roles.ts",
    "db:migrate:neon": "USE_LOCAL_DB=false drizzle-kit migrate",
    "db:push:neon": "USE_LOCAL_DB=false drizzle-kit push",
    "db:studio:neon": "USE_LOCAL_DB=false drizzle-kit studio",
    "db:seed:neon": "USE_LOCAL_DB=false tsx scripts/seed.ts",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f postgres",
    "docker:reset": "docker-compose down -v && docker-compose up -d",
    "prepare": "husky",
    "lint": "npx eslint . --fix --max-warnings 0 --config eslint.config.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-email/components": "^1.0.4",
    "@react-router/serve": "7.12.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/qrcode": "^1.5.6",
    "@vercel/react-router": "^1.2.5",
    "better-auth": "^1.4.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "drizzle-seed": "^0.3.1",
    "drizzle-zod": "^0.8.3",
    "html5-qrcode": "^2.3.8",
    "i18next": "^25.8.10",
    "input-otp": "^1.4.2",
    "isbot": "^5.1.31",
    "lucide-react": "^0.562.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "postgres": "^3.4.8",
    "qrcode": "^1.5.4",
    "qz-tray": "^2.2.5",
    "radix-ui": "^1.4.3",
    "react": "^19.1.1",
    "react-day-picker": "^9.13.0",
    "react-dom": "^19.1.1",
    "react-i18next": "^16.5.4",
    "react-router": "7.12.0",
    "react-router-dom": "7.12.0",
    "recharts": "^3.7.0",
    "remix-themes": "^2.0.4",
    "resend": "^6.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "vaul": "^1.1.2",
    "xlsx": "^0.18.5",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.5",
    "@eslint/js": "^9.39.2",
    "@react-router/dev": "7.12.0",
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22",
    "@types/pg": "^8.16.0",
    "@types/qz-tray": "^2.2.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.53.0",
    "vite": "^7.1.7",
    "vite-plugin-devtools-json": "^1.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.18",
    "wrangler": "^4.59.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "npx eslint . --fix --max-warnings 0 --config eslint.config.ts",
      "prettier --write"
    ]
  }
}
